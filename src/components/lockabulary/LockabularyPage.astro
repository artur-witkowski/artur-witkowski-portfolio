---
// Plain English pages for the Lockabulary app: the product page (which App Store Connect also
// uses as its support URL) and the privacy policy. Colours and font are the app's own.
interface Props {
  title: string;
  description: string;
  path: string;
  // the product page lays out its own full-width sections; the policy reads in one narrow column
  wide?: boolean;
}
const { title, description, path, wide = false } = Astro.props;
const url = `https://arturwitkowski.com/${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#F6CDB8" />
    <link rel="icon" href="/lockabulary/icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/lockabulary/icon.png" />
    <link rel="preload" href="/lockabulary/bricolage.woff2" as="font" type="font/woff2" crossorigin />
    <style is:global>
      @font-face {
        font-family: 'Bricolage Grotesque';
        src: url('/lockabulary/bricolage.woff2') format('woff2');
        font-weight: 200 800;
        font-display: swap;
      }
      :root {
        --bg: #F6CDB8; --card: #FFF8EC; --ink: #3A2A2A; --soft: #7a5e55; --line: #3A2A2A;
        --accent: #C9452F; --tomato: #E5533D; --teal: #1F8A8A; --mint: #8FCDB9;
        --mustard: #F2B33D; --sun: #FFE2A0; --tint: #FBE3D6;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #241c19; --card: #2f2521; --ink: #f4e9e1; --soft: #c2aca1; --line: #0f0a09;
          --accent: #ef7e68; --tint: #3a2d28; --sun: #6b5228;
        }
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font: 17px/1.6 'Bricolage Grotesque', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
        font-variation-settings: 'opsz' 14;
        -webkit-font-smoothing: antialiased;
      }
      h1, h2, h3 { font-variation-settings: 'opsz' 96; letter-spacing: -0.02em; }
      a { color: var(--accent); }
      img { max-width: 100%; height: auto; }
      .soft { color: var(--soft); }

      .site-header {
        max-width: 1120px; margin: 0 auto; padding: 22px 20px;
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
      }
      .brand { display: flex; align-items: center; gap: 12px; color: var(--ink); text-decoration: none; font-weight: 800; font-size: 21px; }
      .brand img { width: 44px; height: 44px; border-radius: 11px; }
      .site-nav { display: flex; gap: 22px; font-weight: 600; font-size: 15px; }
      .site-nav a { color: var(--ink); text-decoration: none; }
      .site-nav a:hover { color: var(--accent); }
      @media (max-width: 760px) { .site-nav .optional { display: none; } }

      .narrow { max-width: 720px; margin: 0 auto; padding: 16px 20px 64px; }
      .narrow h1 { font-size: 38px; line-height: 1.1; margin: 0 0 8px; }
      .narrow h2 { font-size: 21px; margin: 34px 0 6px; }
      .narrow p { margin: 0 0 14px; }
      .card { background: var(--card); border-radius: 18px; padding: 18px 20px; margin: 22px 0; }

      .site-footer {
        max-width: 1120px; margin: 0 auto; padding: 32px 20px 48px; color: var(--soft); font-size: 15px;
        display: flex; flex-wrap: wrap; gap: 8px 22px; justify-content: space-between;
      }
      .site-footer nav { display: flex; gap: 18px; flex-wrap: wrap; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/lockabulary">
        <img src="/lockabulary/icon.png" alt="" width="44" height="44" />
        Lockabulary
      </a>
      <nav class="site-nav" aria-label="Lockabulary">
        <a class="optional" href="/lockabulary#how">How it works</a>
        <a class="optional" href="/lockabulary#pricing">Pricing</a>
        <a href="/lockabulary#help">Help</a>
      </nav>
    </header>
    {wide ? <slot /> : <main class="narrow"><slot /></main>}
    <footer class="site-footer">
      <nav aria-label="Footer">
        <a href="/lockabulary#help">Support</a>
        <a href="/lockabulary/privacy">Privacy</a>
        <a href="mailto:contact@arturwitkowski.com">contact@arturwitkowski.com</a>
      </nav>
      <span>Made by <a href="/en/">Artur Witkowski</a></span>
    </footer>
  </body>
</html>
