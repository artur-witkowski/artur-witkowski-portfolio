---
// Cloudflare Pages answers unknown paths with this file and a real 404 status.
// Without it, every unknown path returned the root page with status 200.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found</title>
    <meta name="robots" content="noindex" />
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #241c19; color: #f4e9e1; font: 17px/1.6 -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif; }
      main { padding: 24px; max-width: 32em; }
      a { color: #ef7e68; }
    </style>
  </head>
  <body>
    <main>
      <h1>Page not found</h1>
      <p>Nothing lives at this address. Try one of these:</p>
      <ul>
        <li><a href="/en/">Artur Witkowski, portfolio</a></li>
        <li><a href="/lockabulary/">Lockabulary</a></li>
      </ul>
    </main>
  </body>
</html>
