---
import type { Lang } from '@/i18n/index';
import { t } from '@/i18n/index';
import type { Project } from '@/data/projects';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const stores = project.stores ?? [];
const box = 'h-[46px] px-5 text-[14.5px] rounded-[10px]';
---

<div class="flex flex-wrap items-center gap-2">
  <a
    href={project.url}
    target="_blank"
    rel="noopener noreferrer"
    class={`cta cta-primary inline-flex items-center justify-center gap-1.5 border border-transparent whitespace-nowrap font-body font-semibold cursor-pointer group ${box}`}
  >
    {t('projects.visit', lang)}
    <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14" /><path d="m12 5 7 7-7 7" />
    </svg>
  </a>
  {stores.map((store) => (
    <a
      href={store.url}
      target="_blank"
      rel="noopener noreferrer"
      class={`cta cta-secondary inline-flex items-center justify-center gap-1.5 whitespace-nowrap border border-border bg-surface/40 text-text font-body font-medium cursor-pointer ${box}`}
      aria-label={`${project.name}: ${store.icon === 'apple' ? 'App Store' : 'Google Play'}, ${store.label}`}
    >
      {store.icon === 'apple' ? (
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.77-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.75 2.27-1.6 2.78-.41 6.89 1.15 9.14.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.38-.92-2.4-3.66zM14.1 5.86c.63-.77 1.06-1.83.94-2.89-.91.04-2.01.61-2.66 1.37-.58.67-1.1 1.76-.96 2.8 1.01.08 2.05-.52 2.68-1.28z" />
        </svg>
      ) : (
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M4.6 2.3c-.3.3-.5.8-.5 1.4v16.6c0 .6.2 1.1.5 1.4l.1.1 9.3-9.3v-.2L4.7 2.2l-.1.1zm12.5 12.5-3.1-3.1v-.2l3.1-3.1.1.1 3.7 2.1c1 .6 1 1.6 0 2.2l-3.7 2.1-.1-.1zm-.1.1L13.8 12l-9.2 9.7c.3.4.9.4 1.6 0l10.8-6.8m0-5.8L6.2 2.3c-.7-.4-1.3-.4-1.6 0l9.2 9.7 3.2-3.2z" />
        </svg>
      )}
      {store.label}
    </a>
  ))}
</div>
